# Copy to .env (gitignored) and adjust.

# SSH destination of the vaultwarden server (anything `ssh` accepts, incl. ~/.ssh/config aliases)
SSH_HOST=user@vault.example.com

# Path to the docker compose file on the remote host
REMOTE_COMPOSE_PATH=/opt/vaultwarden/docker-compose.yml

# Optional: prefix for remote docker commands if the SSH user isn't in the docker group
# (needs passwordless sudo, since there is no TTY)
#REMOTE_SUDO=sudo

# Optional: number of backups to keep (default 5)
#KEEP=5
